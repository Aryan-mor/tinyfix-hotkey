<!-- One endpoint: protocol preset, model id, base URL, key, timeout and a test button. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="using:Avalonia.Automation"
             xmlns:vm="using:TinyFix.App.ViewModels"
             x:Class="TinyFix.App.Views.Controls.EndpointEditor"
             x:DataType="vm:EndpointEditorViewModel">
  <StackPanel Spacing="10">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
    <CheckBox IsChecked="{Binding UseThis}" Content="{Binding UseLabel}" IsVisible="{Binding AllowSkip}" />
    <StackPanel Spacing="10" IsVisible="{Binding FieldsVisible}">
      <StackPanel>
        <TextBlock Text="{DynamicResource models.protocol}" Classes="label" />
        <ComboBox x:Name="ProtocolBox" SelectedIndex="{Binding ProtocolIndex}" MinWidth="320">
          <ComboBoxItem Content="{DynamicResource models.provider_google}" />
          <ComboBoxItem Content="{DynamicResource models.provider_openrouter}" />
          <ComboBoxItem Content="{DynamicResource models.provider_openai}" />
          <ComboBoxItem Content="{DynamicResource models.provider_anthropic}" />
          <ComboBoxItem Content="{DynamicResource models.provider_ollama}" />
          <ComboBoxItem Content="{DynamicResource models.provider_lmstudio}" />
          <ComboBoxItem Content="{DynamicResource models.provider_custom}" />
        </ComboBox>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{DynamicResource models.model}" Classes="label" />
        <TextBox Text="{Binding Model}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{DynamicResource models.base_url}" Classes="label" />
        <TextBox Text="{Binding BaseUrl}" PlaceholderText="{Binding BaseUrlHint}" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource models.api_key}" Classes="label" />
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowInput}">
          <TextBox Grid.Column="0" Text="{Binding ApiKey}" PasswordChar="{Binding PasswordChar}" IsTabStop="True" />
          <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="40" Padding="10,0"
                  Command="{Binding ToggleRevealCommand}"
                  automation:AutomationProperties.Name="{Binding RevealName}">
            <Panel>
              <PathIcon Data="{StaticResource Icon.Eye}" IsVisible="{Binding ShowEye}" Width="18" Height="18" />
              <PathIcon Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding ShowEyeOff}" Width="18" Height="18" />
            </Panel>
          </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsReplacing}">
          <Button Content="{DynamicResource models.save}" Command="{Binding SaveReplacementCommand}"
                  automation:AutomationProperties.Name="{DynamicResource models.save}" />
          <Button Content="{DynamicResource models.cancel}" Command="{Binding CancelKeyEditCommand}"
                  automation:AutomationProperties.Name="{DynamicResource models.cancel}" />
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding IsSaved}">
          <TextBlock Text="{Binding MaskedKey}" IsHitTestVisible="False" Focusable="False" FontFamily="Consolas, Menlo, monospace" />
          <TextBlock Text="{DynamicResource models.key_saved}" Classes="caption" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource models.replace}" Command="{Binding BeginReplaceCommand}"
                    automation:AutomationProperties.Name="{DynamicResource models.replace}" />
            <Button Content="{DynamicResource models.remove}" Command="{Binding BeginRemoveCommand}"
                    automation:AutomationProperties.Name="{DynamicResource models.remove}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding IsConfirmingRemove}">
          <TextBlock Text="{DynamicResource models.remove_confirm}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource models.remove}" Command="{Binding ConfirmRemoveCommand}"
                    automation:AutomationProperties.Name="{DynamicResource models.remove}" />
            <Button Content="{DynamicResource models.cancel}" Command="{Binding CancelKeyEditCommand}"
                    automation:AutomationProperties.Name="{DynamicResource models.cancel}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{DynamicResource models.timeout}" Classes="label" />
        <TextBox Text="{Binding Timeout}" Width="120" HorizontalAlignment="Left" />
      </StackPanel>
      <Button Content="{DynamicResource models.test}" Command="{Binding TestCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
