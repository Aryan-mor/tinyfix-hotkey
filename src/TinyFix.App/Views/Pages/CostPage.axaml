<!-- Cost page: tokens and money per model, and how often the fallback answered. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyFix.App.ViewModels"
             x:Class="TinyFix.App.Views.Pages.CostPage"
             x:DataType="vm:CostPageViewModel">
  <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{DynamicResource cost.desc}" Classes="caption" TextWrapping="Wrap" />
    </StackPanel>
    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="PeriodBox" SelectedIndex="{Binding PeriodIndex}" MinWidth="200">
            <ComboBoxItem Content="{DynamicResource cost.period_today}" />
            <ComboBoxItem Content="{DynamicResource cost.period_month}" />
            <ComboBoxItem Content="{DynamicResource cost.period_all}" />
          </ComboBox>
          <Button Content="{DynamicResource cost.edit_prices}" Command="{Binding EditPricesCommand}" />
          <Button Content="{Binding ResetText}" Command="{Binding ResetCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding TotalText}" Classes="h2" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TokensText}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource cost.partial}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Partial}" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource cost.by_model}" Classes="label" />
        <TextBlock Text="{DynamicResource cost.empty}" Classes="caption" IsVisible="{Binding !HasRows}" />
        <Grid ColumnDefinitions="*,110,110,110,100" IsVisible="{Binding HasRows}">
          <TextBlock Grid.Column="0" Text="{DynamicResource cost.col_model}" Classes="caption" />
          <TextBlock Grid.Column="1" Text="{DynamicResource cost.col_requests}" Classes="caption" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="{DynamicResource cost.col_in}" Classes="caption" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="{DynamicResource cost.col_out}" Classes="caption" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Text="{DynamicResource cost.col_cost}" Classes="caption" HorizontalAlignment="Right" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CostRow">
              <Grid ColumnDefinitions="*,110,110,110,100" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Requests}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding Input}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding Output}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding Cost}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="{DynamicResource cost.fallback_title}" Classes="label" />
        <TextBlock Text="{Binding FallbackText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FailuresText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
