<!-- About page: version, links, platform notes and the third-party notices. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyFix.App.ViewModels"
             x:Class="TinyFix.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="avares://TinyFix/Assets/Icons/tinyfix.ico" Width="56" Height="56" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource app.name}" Classes="h1" />
          <TextBlock Text="{Binding VersionText}" Classes="caption" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{DynamicResource about.description}" TextWrapping="Wrap" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Button x:Name="RepositoryButton" Content="{DynamicResource about.repository}" HorizontalAlignment="Left" />
          <Button Content="{DynamicResource setup.about_again}" Command="{Binding RunSetupAgainCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="{DynamicResource setup.about_again}" />
          <TextBlock Text="{Binding SecretBackend}" Classes="caption" />
          <TextBlock Text="{DynamicResource about.translations}" Classes="caption" />
          <TextBlock Text="{DynamicResource about.experimental}" Classes="warning" IsVisible="{Binding ShowExperimental}" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource about.notices}" FontWeight="SemiBold" />
          <TextBox Text="{Binding Notices}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="260" FontFamily="Consolas, Menlo, monospace" FontSize="12" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
