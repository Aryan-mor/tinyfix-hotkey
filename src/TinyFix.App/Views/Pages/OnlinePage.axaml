<!-- Online AI page: provider, key, models and timeout; test and save. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyFix.App.ViewModels"
             x:Class="TinyFix.App.Views.Pages.OnlinePage"
             x:DataType="vm:OnlinePageViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{DynamicResource online.desc}" Classes="caption" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <ToggleSwitch IsChecked="{Binding Enabled}" Content="{DynamicResource online.enable}" />
          <StackPanel>
            <TextBlock Text="{DynamicResource online.provider}" Classes="label" />
            <ComboBox SelectedIndex="{Binding ProviderIndex}" MinWidth="320">
              <ComboBoxItem Content="{DynamicResource online.provider_google}" />
              <ComboBoxItem Content="{DynamicResource online.provider_openrouter}" />
              <ComboBoxItem Content="{DynamicResource online.provider_openai}" />
            </ComboBox>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{DynamicResource online.api_key}" Classes="label" />
            <TextBox Text="{Binding ApiKey}" PasswordChar="*" />
            <TextBlock Text="{DynamicResource online.api_key_saved}" Classes="caption" Margin="0,4,0,0" IsVisible="{Binding HasSavedKey}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowBaseUrl}">
            <TextBlock Text="{DynamicResource online.base_url}" Classes="label" />
            <TextBox Text="{Binding BaseUrl}" PlaceholderText="http://127.0.0.1:11434/v1" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{DynamicResource online.model}" Classes="label" />
            <TextBox Text="{Binding Model}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{DynamicResource online.fallback_model}" Classes="label" />
            <TextBox Text="{Binding FallbackModel}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{DynamicResource online.timeout}" Classes="label" />
            <TextBox Text="{Binding Timeout}" Width="120" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{DynamicResource online.target_language}" Classes="label" />
            <TextBox Text="{Binding TargetLanguage}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource online.save}" Command="{Binding SaveCommand}" Classes="accent" />
            <Button Content="{DynamicResource online.test}" Command="{Binding TestCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SecretWarning}" Classes="warning" IsVisible="{Binding SecretWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{DynamicResource online.privacy}" Classes="caption" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
