<!-- AI models page: a main endpoint and an optional fallback. Each has its own test button. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyFix.App.ViewModels"
             xmlns:c="using:TinyFix.App.Views.Controls"
             x:Class="TinyFix.App.Views.Pages.OnlinePage"
             x:DataType="vm:OnlinePageViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{DynamicResource models.desc}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="16">
          <c:EndpointEditor DataContext="{Binding Main}" />
          <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" />
          <TextBlock Text="{DynamicResource models.fallback_help}" Classes="caption" TextWrapping="Wrap" />
          <c:EndpointEditor DataContext="{Binding Fallback}" />
          <Button Content="{DynamicResource models.save}" Command="{Binding SaveCommand}" Classes="accent" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SecretWarning}" Classes="warning" IsVisible="{Binding SecretWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{DynamicResource models.privacy}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
