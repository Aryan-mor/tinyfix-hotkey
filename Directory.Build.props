<!--
  Shared MSBuild settings for every C# project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>2.0.1</Version>
    <Product>TinyFix</Product>
    <Authors>TinyFix contributors</Authors>
    <Copyright>Copyright (c) TinyFix contributors</Copyright>

    <!-- Single source of truth for the GitHub repository (About page). -->
    <TinyFixRepositoryUrl>https://github.com/Aryan-mor/tinyfix-hotkey</TinyFixRepositoryUrl>
    <RepositoryUrl>$(TinyFixRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
